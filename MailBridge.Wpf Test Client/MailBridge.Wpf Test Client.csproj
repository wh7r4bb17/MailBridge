<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<RootNamespace>MailBridge.Wpf</RootNamespace>
		<AssemblyName>MailBridge Test Client</AssemblyName>
		<Cert>wh7r4bb17</Cert>
	</PropertyGroup>

	<!--  Assembly Identity  -->
	<PropertyGroup>
		<AssemblyTitle>MailBridge Test Client</AssemblyTitle>
		<AssemblyVersion>$(Version)</AssemblyVersion>
		<FileVersion>$(Version)</FileVersion>
		<Version>26.1.1</Version>
		<Product>A Wpf Test Client to send emails using MailBridge.Core</Product>
		<Description>A Wpf Test Client to send emails using MailBridge.Core.</Description>
		<Company>wh7r4bb17</Company>
		<Authors>wh7r4bb17</Authors>
		<Copyright>Copyright © 2026</Copyright>
		<ApplicationIcon>Resources\EvilRabbit.ico</ApplicationIcon>
	</PropertyGroup>

	<!--  Licensing and Repository  -->
	<PropertyGroup>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<RepositoryUrl>https://github.com/wh7r4bb17/MailBridge/tree/master/MailBridge.Wpf</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MailKit" Version="4.17.0" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MailBridge.Core\MailBridge.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\EvilRabbit.png" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="NLog.config">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.BeforeEnd.targets', '$(MSBuildThisFileDirectory)../'))" Condition="Exists($([MSBuild]::GetPathOfFileAbove('Directory.Build.BeforeEnd.targets', '$(MSBuildThisFileDirectory)../')))" />

</Project>
